{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly", "helpers:pinGitHubActionDigests"],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "npm globals installed in the kit Dockerfiles",
      "fileMatch": ["(^|/)common-.*\\.dockerfile$"],
      "matchStrings": ["npm install -g (?<depName>@?[\\w./-]+)@(?<currentValue>[\\w.-]+)"],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Base sandbox-template image",
      "fileMatch": ["(^|/)common-.*\\.dockerfile$"],
      "matchStrings": ["docker/sandbox-templates:(?<currentValue>[\\w.-]+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker/sandbox-templates"
    },
    {
      "customType": "regex",
      "description": "Repomix used by the converter",
      "fileMatch": ["(^|/)tools/convert\\.mjs$"],
      "matchStrings": ["repomix@(?<currentValue>[\\w.-]+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "repomix"
    },
    {
      "customType": "regex",
      "description": "sisakulint pinned in tools/sisakulint.version",
      "fileMatch": ["(^|/)tools/sisakulint\\.version$"],
      "matchStrings": ["(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "sisaku-security/sisakulint"
    },
    {
      "customType": "regex",
      "description": "Portable Go pinned in tools/golang.version",
      "fileMatch": ["(^|/)tools/golang\\.version$"],
      "matchStrings": ["(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "golang"
    }
  ],
  "packageRules": [
    {
      "description": "Security fixes from Dependabot alerts: no release-age delay, high priority",
      "matchCategories": ["security"],
      "labels": ["security"],
      "prPriority": 20,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Group all non-major updates into a single PR",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Pin base image digests and keep them updated",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Group the kit CLI tool pins (waza, ax, ...)",
      "matchDatasources": ["github-releases"],
      "matchFileNames": ["common-*/**"],
      "groupName": "kit CLI tools",
      "groupSlug": "kit-cli-tools"
    },
    {
      "description": "Group nixpkgs / flake.lock updates (Renovate nix manager)",
      "matchManagers": ["nix"],
      "groupName": "nixpkgs",
      "groupSlug": "nixpkgs"
    },
    {
      "matchPackageNames": ["@opencode/cli"],
      "prPriority": 10
    }
  ]
}
