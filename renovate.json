{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly", "helpers:pinGitHubActionDigests"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "npm globals installed in the kit Dockerfiles",
      "fileMatch": ["(^|/)common-.*\\.dockerfile$"],
      "matchStrings": ["npm install -g (?<depName>@[\\w./-]+|[a-z0-9-]+)"],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Base sandbox-template image",
      "fileMatch": ["(^|/)common-.*\\.dockerfile$"],
      "matchStrings": ["docker/sandbox-templates:(?<currentValue>[\\w.-]+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker/sandbox-templates"
    },
    {
      "customType": "regex",
      "description": "Repomix used by the converter",
      "fileMatch": ["(^|/)tools/convert\\.mjs$"],
      "matchStrings": ["repomix@(?<currentValue>[\\w.-]+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "repomix"
    },
    {
      "customType": "regex",
      "description": "sisakulint pinned in tools/sisakulint.version",
      "fileMatch": ["(^|/)tools/sisakulint\\.version$"],
      "matchStrings": ["(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "sisaku-security/sisakulint"
    },
    {
      "customType": "regex",
      "description": "Portable Go pinned in tools/golang.version",
      "fileMatch": ["(^|/)tools/golang\\.version$"],
      "matchStrings": ["(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "golang"
    },
    {
      "customType": "regex",
      "description": "waza pinned in the kit Dockerfiles",
      "fileMatch": ["(^|/)common-.*\\.dockerfile$"],
      "matchStrings": ["ARG WAZA_VERSION=(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "microsoft/waza",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "ax pinned in the kit Dockerfiles",
      "fileMatch": ["(^|/)common-.*\\.dockerfile$"],
      "matchStrings": ["ARG AX_VERSION=(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "yusukebe/ax"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["@opencode/cli"],
      "prPriority": 10
    }
  ]
}
